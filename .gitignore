# ===============================
# Node.js
# ===============================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===============================
# Environment variables (NEVER commit these!)
# ===============================
.env
.env.*
!.env.example   # keep a safe example file (without secrets)

# ===============================
# Prisma
# ===============================
# Generated Prisma client (safe to regenerate, no need to commit)
.prisma/
# Optional: if you use Docker, this cache dir can appear
prisma/.cache/

# Keep schema + migrations (safe & recommended to commit)
# prisma/schema.prisma
# prisma/migrations/

# ===============================
# Logs
# ===============================
*.log
logs
*.pid
*.seed
*.pid.lock

# ===============================
# Build artifacts
# ===============================
dist/
build/
.cache/
.next/
out/

# ===============================
# OS files
# ===============================
.DS_Store
Thumbs.db
.vercel
